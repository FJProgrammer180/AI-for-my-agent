{
  "name": "finova",
  "version": "1.0.0",
  "private": true,
  "description": "FINOVA — Platform Manajemen Keuangan Pribadi & Integrasi Perbankan",
  "main": "backend/server.js",
  "scripts": {
    "dev": "NODE_ENV=development node backend/server.js",
    "start": "node backend/server.js",
    "migrate": "node backend/scripts/migrate.js",
    "migrate:down": "node backend/scripts/migrate.js down --force",
    "seed": "node backend/scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:api": "node --test \"tests/api/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "market:snapshot": "node backend/scripts/generate-market-snapshot.js",
    "demo": "node backend/scripts/dev-demo.js",
    "admin": "node backend/scripts/create-admin.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lightweight-charts": "^5.2.1",
    "pg": "^8.13.1",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "jsdom": "^30.1.2"
  }
}
