# ===================== FINOVA — konfigurasi =====================
# Salin menjadi `.env` lalu isi nilainya. JANGAN meng-commit `.env`.

# ---- Server ----
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finova
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Sesi & cookie ----
# Wajib diganti di production dengan nilai acak panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# ---- Pembatasan laju (rate limiting) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_API_MAX=600

# ---- Integrasi Bank Mandiri (Open Banking / SNAP BI) ----
# Kosong = mode contoh: modul Rekening memakai akun demo berlabel "Demo" dan
# TIDAK menampilkan angka sebagai rekening asli. Isi ketiganya hanya bila kamu
# sudah menerima kredensial resmi yang disetujui.
MANDIRI_CLIENT_ID=
MANDIRI_CLIENT_SECRET=
MANDIRI_BASE_URL=
MANDIRI_SNAPSHOT_PATH=backend/providers/snapshots/mandiri-demo.json

# ---- Data pasar ----
# snapshot = data contoh lokal (default). live = penyedia resmi berlisensi.
MARKET_PROVIDER=snapshot
MARKET_SNAPSHOT_PATH=backend/providers/snapshots/market-snapshot.json
TWELVEDATA_API_KEY=
